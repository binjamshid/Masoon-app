{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "masoon.assessment-form.v1",
  "title": "Masoon Assessment Form Definition v1",
  "description": "Organization-defined assessment form definition. A form version carries a definition that validates against this schema.",
  "type": "object",
  "required": [
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/FieldDef"
      }
    },
    "outcome_field": {
      "$ref": "#/$defs/FieldKey",
      "description": "Field whose value determines the pass or fail outcome."
    }
  },
  "$defs": {
    "FieldKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "LocalizedLabel": {
      "type": "object",
      "required": [
        "ar"
      ],
      "additionalProperties": false,
      "properties": {
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Visibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "teacher",
          "supervisor",
          "parent",
          "student"
        ]
      }
    },
    "FieldDef": {
      "type": "object",
      "required": [
        "key",
        "type",
        "label",
        "visibility"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/FieldKey"
        },
        "type": {
          "enum": [
            "int",
            "text",
            "bool",
            "enum",
            "rating"
          ]
        },
        "label": {
          "$ref": "#/$defs/LocalizedLabel"
        },
        "required": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "enum"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "values"
        ],
        "properties": {
          "values": true
        }
      }
    }
  }
}
