{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "masoon.audio_surah_package.v2",
  "title": "Masoon Audio Surah Package v2",
  "description": "Versioned per-surah package descriptor with explicit canonical coordinates.",
  "type": "object",
  "required": [
    "schema_version",
    "reciter_id",
    "surah",
    "ayah_count",
    "byte_size",
    "checksum",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "reciter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "surah": {
      "type": "integer",
      "minimum": 1,
      "maximum": 114
    },
    "ayah_count": {
      "type": "integer",
      "minimum": 1
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1
    },
    "checksum": {
      "$ref": "#/$defs/Sha256"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Entry"
      }
    }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Entry": {
      "type": "object",
      "required": [
        "key",
        "surah",
        "ayah",
        "byte_size",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[0-9]{6}\\.mp3$"
        },
        "surah": {
          "type": "integer",
          "minimum": 1,
          "maximum": 114
        },
        "ayah": {
          "type": "integer",
          "minimum": 1
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    }
  }
}
