{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "masoon.corpus-ref.v1",
  "title": "Masoon Corpus Reference Document v1",
  "description": "Versioned reference data for ordered works and their unit counts. Use counts verified against the cited edition.",
  "type": "object",
  "required": [
    "corpus_id",
    "corpus_kind",
    "title",
    "recension",
    "source_sha256",
    "units_per_page",
    "unit_micropages",
    "atomic_unit",
    "boundary_kind",
    "works"
  ],
  "additionalProperties": false,
  "properties": {
    "corpus_id": {
      "description": "Stable identifier for a corpus. Each work has a separate slug.",
      "$ref": "#/$defs/Identifier"
    },
    "corpus_kind": {
      "description": "Kind used by a curriculum to declare applicability. Multiple concrete corpora can share the same kind.",
      "enum": [
        "quran",
        "poem"
      ]
    },
    "title": {
      "description": "Display title of the collection.",
      "$ref": "#/$defs/LocalizedText"
    },
    "recension": {
      "description": "The named edition or recension used to count the units.",
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "description": "SHA-256 digest of the counts source for provenance.",
      "$ref": "#/$defs/Sha256Hex"
    },
    "units_per_page": {
      "description": "Number of atomic units in one page-equivalent for this format.",
      "const": 10
    },
    "unit_micropages": {
      "description": "Size of one atomic unit in micropages.",
      "const": 100000
    },
    "atomic_unit": {
      "description": "Name of an atomic unit, such as bayt.",
      "type": "string",
      "minLength": 1
    },
    "boundary_kind": {
      "description": "Curriculum trigger vocabulary used for boundaries between works.",
      "$ref": "#/$defs/BoundaryKind"
    },
    "works": {
      "description": "Individual works in their declared order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Work"
      }
    },
    "disagreements": {
      "description": "Unit-count discrepancies between editions and how they were resolved.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Disagreement"
      }
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "LocalizedText": {
      "type": "object",
      "required": [
        "ar"
      ],
      "additionalProperties": false,
      "properties": {
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "BoundaryKind": {
      "enum": [
        "corpus_block",
        "work_boundary"
      ]
    },
    "Work": {
      "type": "object",
      "required": [
        "no",
        "slug",
        "unit_count",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "no": {
          "description": "One-based position of the work within the corpus.",
          "type": "integer",
          "minimum": 1
        },
        "slug": {
          "$ref": "#/$defs/Identifier"
        },
        "unit_count": {
          "description": "Total atomic units in the cited edition of this work.",
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        }
      }
    },
    "EditionCount": {
      "type": "object",
      "required": [
        "source",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Disagreement": {
      "type": "object",
      "required": [
        "work_slug",
        "editions",
        "resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "work_slug": {
          "$ref": "#/$defs/Identifier"
        },
        "editions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/EditionCount"
          }
        },
        "resolution": {
          "description": "Explanation of the resolution. Null records an unresolved discrepancy.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
