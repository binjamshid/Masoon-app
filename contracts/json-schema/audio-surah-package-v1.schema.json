{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "masoon.audio_surah_package.v1",
  "title": "Masoon Audio Surah Package v1",
  "description": "Legacy per-surah package descriptor. Each exact six-digit MP3 key encodes the canonical coordinates. Clients verify the decoded surah against the package surah.",
  "type": "object",
  "required": [
    "reciter_id",
    "surah",
    "ayah_count",
    "byte_size",
    "checksum",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "reciter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "surah": {
      "type": "integer",
      "minimum": 1,
      "maximum": 114
    },
    "ayah_count": {
      "type": "integer",
      "minimum": 1
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1
    },
    "checksum": {
      "$ref": "#/$defs/Sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/File"
      }
    }
  },
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "File": {
      "type": "object",
      "required": [
        "key",
        "byte_size",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[0-9]{6}\\.mp3$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    }
  }
}
