{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "masoon.adhkar.v1",
  "title": "Masoon Adhkar Pack v1",
  "description": "A collection of cited remembrance entries and their placements in categories. Each placement can carry its own repetition count and practice citation.",
  "type": "object",
  "required": [
    "meta",
    "categories",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "morning": {
          "$ref": "#/$defs/Category"
        },
        "evening": {
          "$ref": "#/$defs/Category"
        },
        "sleep": {
          "$ref": "#/$defs/Category"
        },
        "after_prayer": {
          "$ref": "#/$defs/Category"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/DhikrEntry"
      }
    },
    "tasbih_defaults": {
      "description": "Editable default targets for the tasbih counter.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "LocalizedText": {
      "type": "object",
      "required": [
        "ar"
      ],
      "additionalProperties": false,
      "properties": {
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CategoryId": {
      "description": "Category identifiers for the four placements supported by this document version.",
      "enum": [
        "morning",
        "evening",
        "sleep",
        "after_prayer"
      ]
    },
    "DefaultReminder": {
      "description": "At most one suggested reminder per category.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "time"
          ],
          "additionalProperties": false,
          "properties": {
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "prayer_relative"
          ],
          "additionalProperties": false,
          "properties": {
            "prayer_relative": {
              "type": "object",
              "required": [
                "prayer",
                "offset_min"
              ],
              "additionalProperties": false,
              "properties": {
                "prayer": {
                  "enum": [
                    "fajr",
                    "dhuhr",
                    "asr",
                    "maghrib",
                    "isha"
                  ]
                },
                "offset_min": {
                  "type": "integer",
                  "minimum": -240,
                  "maximum": 240
                }
              }
            }
          }
        }
      ]
    },
    "Category": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "default_reminder": {
          "$ref": "#/$defs/DefaultReminder"
        }
      }
    },
    "Placement": {
      "description": "A category placement of an entry. A repetition count of two or more requires its own practice citation.",
      "type": "object",
      "required": [
        "category",
        "repeat_count"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/CategoryId"
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 1
        },
        "practice_citation_ar": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "repeat_count": {
            "type": "integer",
            "minimum": 2
          }
        },
        "required": [
          "repeat_count"
        ]
      },
      "then": {
        "required": [
          "practice_citation_ar"
        ],
        "properties": {
          "practice_citation_ar": true
        }
      }
    },
    "QuranSource": {
      "description": "Qur’an text with a citation derived from the canonical range.",
      "type": "object",
      "required": [
        "kind",
        "surah",
        "ayah_start",
        "ayah_end",
        "text_ayahs"
      ],
      "additionalProperties": false,
      "not": {
        "title": "Qur’an source citations are derived from the canonical range.",
        "required": [
          "citation_ar"
        ],
        "properties": {
          "citation_ar": true
        }
      },
      "properties": {
        "kind": {
          "const": "quran"
        },
        "surah": {
          "type": "integer",
          "minimum": 1,
          "maximum": 114
        },
        "ayah_start": {
          "type": "integer",
          "minimum": 1
        },
        "ayah_end": {
          "type": "integer",
          "minimum": 1
        },
        "text_ayahs": {
          "description": "One Arabic string per ayah in canonical range order, preserved from the cited edition.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "AttributedSource": {
      "description": "Attributed non-Qur’an text with a required source citation.",
      "type": "object",
      "required": [
        "kind",
        "text",
        "citation_ar"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "attributed"
        },
        "text": {
          "$ref": "#/$defs/LocalizedText"
        },
        "citation_ar": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SourceSpec": {
      "oneOf": [
        {
          "$ref": "#/$defs/QuranSource"
        },
        {
          "$ref": "#/$defs/AttributedSource"
        }
      ]
    },
    "DhikrEntry": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "id",
            "source",
            "placements"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Identifier"
            },
            "source": {
              "$ref": "#/$defs/SourceSpec"
            },
            "placements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Placement"
              }
            },
            "verified": {
              "description": "Per-entry override of the document verification flag.",
              "type": "boolean"
            },
            "notes": {
              "description": "Provenance notes for reviewers.",
              "type": "string"
            },
            "audio": true,
            "poem_ref": true
          }
        },
        {
          "type": "object",
          "not": {
            "title": "The audio property is reserved for a future format.",
            "required": [
              "audio"
            ],
            "properties": {
              "audio": true
            }
          }
        },
        {
          "type": "object",
          "not": {
            "title": "The poem_ref property is reserved for a future format.",
            "required": [
              "poem_ref"
            ],
            "properties": {
              "poem_ref": true
            }
          }
        }
      ]
    },
    "Meta": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "verified"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "description": {
          "$ref": "#/$defs/LocalizedText"
        },
        "verified": {
          "description": "Whether the imported wording has been reviewed.",
          "type": "boolean"
        },
        "text_source": {
          "$ref": "#/$defs/TextSourceProvenance"
        },
        "open_flags": {
          "description": "Unresolved provenance or verification notes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TextSourceProvenance": {
      "description": "Retrieval timestamps, source locations, cross-check results, and raw-response checksums.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_a": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_b": {
          "type": "string",
          "pattern": "^https://"
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "cross_check": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ayah",
              "match"
            ],
            "additionalProperties": false,
            "properties": {
              "ayah": {
                "type": "string",
                "pattern": "^[0-9]+:[0-9]+$"
              },
              "match": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "checksums": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
