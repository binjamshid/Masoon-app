{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "masoon.evidence-payload.v1",
  "title": "Masoon Evidence Payload v1",
  "description": "Evidence carried by a task completion. An application checks it against the task’s resolved evidence requirement.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "self_check"
        },
        "backdated": {
          "$ref": "#/$defs/Backdated"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "elapsed_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "timer"
        },
        "elapsed_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "backdated": {
          "$ref": "#/$defs/Backdated"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "counter"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "increments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalTime"
          }
        },
        "backdated": {
          "$ref": "#/$defs/Backdated"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "assessment_id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "teacher_verification"
        },
        "assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "backdated": {
          "$ref": "#/$defs/Backdated"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "form_version_id",
        "assessment_id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "form"
        },
        "form_version_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "backdated": {
          "$ref": "#/$defs/Backdated"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "parts"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "composite"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        },
        "backdated": {
          "$ref": "#/$defs/Backdated"
        }
      }
    }
  ],
  "$defs": {
    "Backdated": {
      "type": "boolean",
      "description": "True when the completion was recorded for an earlier local date."
    },
    "LocalTime": {
      "type": "string",
      "description": "Local time of a counter increment in hours and minutes with optional seconds.",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
    }
  }
}
